# คัดลอกเป็น .env แล้วใส่ค่าจริง
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# ใช้ service_role key เท่านั้น (ไม่ใช่ anon key) เพราะ Pi ต้องเขียนข้อมูล
# แทนนักศึกษาโดยไม่ได้ล็อกอินเป็นตัวเขา
# หาได้ที่ Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_KEY="ใส่ service role key ที่นี่"

# รหัสอุปกรณ์และห้องเรียน (ROOM เว้นว่างได้ = รับทุกห้อง)
DEVICE_CODE="PI-ROOM-C3-201"
ROOM=""
