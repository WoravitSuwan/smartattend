# ─────────────────────────────────────────────────────────────────────────
#  SmartAttend — ตัวแปรสภาพแวดล้อมของอุปกรณ์ประจำห้องเรียน (Raspberry Pi)
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก .gitignore ไว้แล้ว)
# ─────────────────────────────────────────────────────────────────────────

# URL ของโปรเจกต์ Supabase
# หาได้ที่ Dashboard > Project Settings > API > Project URL
SUPABASE_URL="https://<your-project-ref>.supabase.co"

# ⚠️ ต้องเป็น service_role key ไม่ใช่ anon key
#    เพราะอุปกรณ์ต้องบันทึกการเข้าเรียนแทนนักศึกษาโดยไม่ได้ล็อกอินเป็นตัวเขา
#    คีย์นี้ข้ามนโยบาย RLS ทั้งหมด จึงอยู่ได้เฉพาะในเครื่องที่ควบคุมทางกายภาพได้
#    ห้ามนำไปใส่ในเว็บ ในแอปมือถือ หรือ commit ขึ้น repo เด็ดขาด
#    หาได้ที่ Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_KEY="<your-service-role-key>"

# รหัสอุปกรณ์ ใช้แยกเครื่องในหน้าสถานะอุปกรณ์และในบันทึกการทำงาน
DEVICE_CODE="PI-ROOM-C3-201"

# ห้องเรียนที่อุปกรณ์นี้ประจำอยู่
# เว้นว่าง = รับทุกห้อง (อุปกรณ์จะเช็คชื่อให้ทุกคาบที่เปิดอยู่)
ROOM=""
