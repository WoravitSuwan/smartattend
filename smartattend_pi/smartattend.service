[Unit]
Description=SmartAttend — โหมดมีจอแสดงผลหน้าห้องเรียน
Documentation=https://github.com/WoravitSuwan/smartattend/blob/main/docs/%E0%B8%84%E0%B8%B9%E0%B9%88%E0%B8%A1%E0%B8%B7%E0%B8%AD%E0%B8%99%E0%B8%B1%E0%B8%81%E0%B8%9E%E0%B8%B1%E0%B8%92%E0%B8%99%E0%B8%B2.md

# time-sync.target สำคัญพอ ๆ กับเครือข่าย
#
# Raspberry Pi ไม่มีนาฬิกาสำรอง (RTC) เมื่อบูตขึ้นมา เวลาของเครื่องจะย้อนไป
# เท่ากับตอนปิดเครื่องครั้งล่าสุด จนกว่าจะซิงก์จากอินเทอร์เน็ตสำเร็จ
# ถ้าโปรแกรมเริ่มก่อนจังหวะนั้น บันทึกการทำงานช่วงแรกจะติดเวลาที่ผิด
# ทำให้ไล่ปัญหาย้อนหลังจากบันทึกไม่ได้
#
# เวลาที่บันทึกลงฐานข้อมูลไม่ได้รับผลกระทบ เพราะ record_attendance() ใช้ now()
# ของเซิร์ฟเวอร์เป็นตัวตัดสินตรงเวลา/มาสาย ไม่ได้เชื่อเวลาที่อุปกรณ์ส่งมา
# ที่แก้ตรงนี้คือความถูกต้องของ "บันทึกการทำงาน" เท่านั้น
#
# ต้องเปิดบริการรอซิงก์เวลาด้วย ไม่งั้น target นี้จะผ่านทันทีโดยไม่รออะไร
#   sudo systemctl enable systemd-time-wait-sync
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

# โหมดนี้ต้องมีเดสก์ท็อปขึ้นก่อน เพราะเปิดหน้าต่าง OpenCV
After=graphical.target

# เปิดพร้อมกันสองโหมดไม่ได้ ทั้งคู่แย่งกล้องตัวเดียวกัน
# ตัวที่สตาร์ตทีหลังจะทำให้ตัวแรกถูกหยุด แทนที่จะพังเงียบ ๆ ด้วย
# "ไม่พบกล้อง" ซึ่งหาสาเหตุยากกว่ามาก
Conflicts=smartattend-headless.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartattend_pi
ExecStart=/home/pi/smartattend_pi/.venv/bin/python pi_agent.py --fullscreen
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# ต้องบอกว่าจะวาดลงจอไหน ไม่งั้น OpenCV เปิดหน้าต่างไม่ได้และโปรแกรมจะตายทันที
# ด้วย "cannot connect to X server" ค่านี้ใช้ได้เมื่อเปิด Desktop Autologin
# ของผู้ใช้ pi ไว้แล้ว (ดู ก.1.2 ขั้นที่ 8)
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority

[Install]
# ผูกกับ graphical.target ไม่ใช่ multi-user.target เพราะต้องรอเดสก์ท็อป
WantedBy=graphical.target
