# ─────────────────────────────────────────────────────────────────────────
#  SmartAttend — ตัวแปรสภาพแวดล้อมฝั่งเว็บ
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก .gitignore ไว้แล้ว)
#
#  ⚠️ ตัวแปรที่ขึ้นต้นด้วย VITE_ จะถูกฝังลงไฟล์ JavaScript ที่ผู้ใช้ทุกคนดาวน์โหลด
#     ห้ามใส่ service_role key หรือความลับใด ๆ ที่นี่เด็ดขาด
#     การคุ้มครองข้อมูลมาจากนโยบาย RLS ในฐานข้อมูล ไม่ใช่จากการซ่อนคีย์
# ─────────────────────────────────────────────────────────────────────────

# URL ของโปรเจกต์ Supabase
# หาได้ที่ Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# publishable key (เดิมเรียก anon key) — ออกแบบให้เปิดเผยได้
# หาได้ที่ Dashboard > Project Settings > API > Project API keys > anon public
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"

# Reference ID ของโปรเจกต์ ใช้เป็นข้อมูลอ้างอิงในหน้าจอผู้ดูแลระบบ
# หาได้ที่ Dashboard > Project Settings > General > Reference ID
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"
