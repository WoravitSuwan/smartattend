# ═══════════════════════════════════════════════════════════════════════════
#  กันไฟล์ความลับทั้ง repo
#
#  ของเดิมมี .gitignore แยกอยู่ใน smartattend_web/ และ smartattend_pi/
#  ซึ่งกันได้แค่ไฟล์ชื่อ ".env" เป๊ะ ๆ ในโฟลเดอร์นั้น
#  ไฟล์นี้กันทุกตำแหน่งในโปรเจกต์และครอบคลุมชื่อที่ใช้กันบ่อยทุกแบบ
# ═══════════════════════════════════════════════════════════════════════════

# ── ไฟล์ตั้งค่าที่มีความลับ ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── ข้อมูลที่ Supabase CLI เก็บไว้หลัง supabase link (มี project ref จริง) ──
supabase/.temp/
**/supabase/.temp/

# ── คีย์และใบรับรอง ────────────────────────────────────────────────────────
*.pem
*.key
!**/public/**/*.key
*.p12
*.pfx
service-account*.json

# ── ของที่ build ออกมาและแคช ───────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# ── Python ─────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]

# ── ไฟล์ของเครื่องและของบรรณาธิการ ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
